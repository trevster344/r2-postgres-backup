# --- PostgreSQL connection --------------------------------------------------
PGHOST=db.example.com
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-db-password
# Required when PG_DUMP_MODE=database; ignored for cluster mode
PGDATABASE=appdb

# --- Dump scope -------------------------------------------------------------
# database = pg_dump the single PGDATABASE (custom compressed .dump)
# cluster  = pg_dumpall --clean the whole cluster (all databases + globals), plain .sql
PG_DUMP_MODE=database

# --- Cloudflare R2 (S3-compatible) ------------------------------------------
# Endpoint format: https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=my-backups
# Optional folder inside the bucket
R2_PATH_PREFIX=postgres

# --- Schedule ---------------------------------------------------------------
# Seconds between backups (default 86400 = 24 hours)
BACKUP_INTERVAL_SECONDS=86400
